# ==============================================================================
# K!larity Enterprise Brain — Environment Variables Template
#
# Owner task: EB-5 Pre-requisite: accounts, keys and environments
# Rules:
# 1. Names and documentation only — NEVER commit secrets or real tokens here.
# 2. Values live in Doppler / Infisical for dev and CI, and AWS SSM Parameter Store for prod.
# 3. Per-tenant connector secrets (OAuth refresh tokens, API keys) are envelope-encrypted
#    per tenant in the database, never stored in environment variables.
# ==============================================================================

# -- Core Platform -------------------------------------------------------------
APP_ENV=development                       # development | staging | production
APP_BASE_URL=http://localhost:3000        # public application root URL
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# -- Database (PostgreSQL 16 with RLS; app role is NOBYPASSRLS) -----------------
DATABASE_URL=postgresql://klarity_app:password@localhost:5432/brain
# The API connects ONLY as klarity_app (NOBYPASSRLS); it refuses klarity_admin/postgres. SQLAlchemy URL: name the driver.
DATABASE_APP_ROLE_URL=postgresql+psycopg://klarity_app:password@localhost:5432/brain
DATABASE_MIGRATION_URL=postgresql://klarity_admin:password@localhost:5432/brain
CONTROL_DATABASE_URL=postgresql://klarity_control:password@localhost:5432/control_plane

# -- API auth / stores (apps/api) ----------------------------------------------
# KLARITY_AUTH_MODE=production (default) trusts only signature-verified Keycloak tokens. "development" accepts
# X-Tenant-ID / X-User-ID headers and is refused when KLARITY_ENV=production.
KLARITY_AUTH_MODE=production
KLARITY_ENV=development
# Without DATABASE_APP_ROLE_URL the API refuses to start unless this is 1 (throwaway in-memory stores).
KLARITY_ALLOW_MEMORY_STORES=0

# -- Object Storage (S3 / SeaweedFS / MinIO) -----------------------------------
# Primary region: ap-south-2 (Hyderabad); fallback: ap-south-1 (Mumbai)
S3_BUCKET=klarity-pool-in-1
S3_REGION=ap-south-2
S3_ENDPOINT=                              # Optional: set for local SeaweedFS or MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -- AWS Key Management Service (KMS) — Risk R-12 Envelope Encryption ----------
AWS_KMS_REGION=ap-south-2
KMS_KEY_PREFIX=alias/klarity-tenant-

# -- Identity & Access Management (Keycloak) -----------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=klarity
KEYCLOAK_CLIENT_ID=klarity-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=

# -- Fine-Grained Authorization (OpenFGA) --------------------------------------
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=

# -- Vector Search (Qdrant) ----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -- Document & Hybrid Search (OpenSearch) -------------------------------------
OPENSEARCH_URL=http://localhost:9200

# -- Workflows & Orchestration (Temporal) --------------------------------------
TEMPORAL_ADDRESS=localhost:7233

# -- Distributed Cache & Coordination (Valkey / Redis) ------------------------
VALKEY_URL=redis://localhost:6379/0

# -- LLM Gateway (LiteLLM) -----------------------------------------------------
# Provider API keys live exclusively inside the LiteLLM gateway, never in application workers
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -- Google Cloud Connectors (Sandbox GCP project) -----------------------------
# Tenant-specific OAuth tokens are stored envelope-encrypted in DB (EB-85)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback
GOOGLE_PUBSUB_TOPIC=projects/klarity-dev/topics/gmail-push
GOOGLE_PUBSUB_SUBSCRIPTION=projects/klarity-dev/subscriptions/gmail-push-sub

# -- WhatsApp Cloud API (Tech Provider App) ------------------------------------
# Tenant-specific phone access tokens are stored envelope-encrypted in DB (EB-85)
META_APP_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# -- Observability & Tracing (Langfuse & OpenTelemetry) ------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
